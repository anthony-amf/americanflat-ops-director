+# A US invoice prints its number beside the invoice date in the header block
+# ("INVOICE  7110  759181 09/18/2026"). The "Invoice No." caption is laid out
+# far from its value, so match the number-then-date pair rather than the label.
+# Verified selective: exactly one hit in an 854 KB storage invoice.
+_US_INVOICE_NO_RE = re.compile(r'\b(\d{6})\s+(\d{2}/\d{2}/\d{4})\b')
+
+
+def invoice_no_from_text(pdf_text):
+    """Return the invoice number printed on a US invoice PDF, or None."""
+    m = _US_INVOICE_NO_RE.search(pdf_text)
+    return m.group(1) if m else None
+
