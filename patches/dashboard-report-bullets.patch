+  if (ss.length < 2) return pointLi(lab.rest, lab);
+  return `<li><span class="vlabel">${esc(lab.label)}</span><ul class="vpts">` +
+    ss.map(x => pointLi(x)).join("") + "</ul></li>";
+}
