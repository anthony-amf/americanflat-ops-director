+// Periods followed by a space that do not end a sentence. Taken from the stored reports:
+// "art. 44", "incl. 7,030". Dotted forms ("e.g.", "i.e.") are caught separately.
+const SENT_ABBR = /(?:^|[\s(])(?:art|incl|excl|approx|vs|etc)$/i;
+
+// Split prose into sentences. Never inside (…) or […], never inside a number (no space
+// follows the dot in "1.8887" or "$6,449.91"), and only where the next word could start a
+// sentence, so "incl. supporting" and "art. 44" stay whole.
+function sentences(text) {
+  const out = [];
+  let start = 0, depth = 0;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (c === "(" || c === "[") { depth++; continue; }
+    if (c === ")" || c === "]") {
+      depth = Math.max(0, depth - 1);
+      // A whole sentence in parentheses — "(Worksheet … rows.) On the MSA basis …" —
+      // ends at the closing bracket.
+      if (!depth && /[.!?]/.test(text[i - 1] || "") && /^\s+[A-Z]/.test(text.slice(i + 1, i + 9))) {
+        out.push(text.slice(start, i + 1).trim());
+        start = i + 1;
+      }
+      continue;
+    }
+    if (depth || (c !== "." && c !== "!" && c !== "?")) continue;
+    const next = /^\s+(\S)/.exec(text.slice(i + 1, i + 9));
+    if (!next || !/[A-Z0-9(\[€$£"“'‘⏳✓⚠✗]/.test(next[1])) continue;
+    const head = text.slice(start, i);
+    if (SENT_ABBR.test(head) || /\.[A-Za-z]$/.test(head)) continue;
+    out.push(text.slice(start, i + 1).trim());
+    start = i + 1;
+  }
+  const tail = text.slice(start).trim();
+  if (tail) out.push(tail);
+  return out;
+}
+
+// A short heading before a colon ("No gaps: …", "SCOPE/COMPLETENESS: OK.") or a warning
+// word before a dash ("UNMATCHED — …"). A few words and no digits, so an ordinary sentence
+// that happens to contain a colon is not mistaken for one. An all-capitals heading
+// introduces a list of points; a sentence-case one is just bolded in place.
+function leadLabel(s) {
+  let m = /^([A-Z][A-Za-z/&' -]{0,38}[A-Za-z]):\s+(\S[\s\S]*)$/.exec(s);
+  // "That was wrong: …" is a sentence, not a heading — skip labels opening on a pronoun or article.
+  if (m && m[1].trim().split(/\s+/).length <= 4 && !/^(?:The|This|That|These|Those|It|A|An|There|We)\b/.test(m[1])) {
+    return { label: m[1] + ":", rest: m[2], heading: !/[a-z]/.test(m[1]) };
+  }
+  m = /^([A-Z][A-Z/]{3,}(?: [A-Z/]{2,}){0,2}) — (\S[\s\S]*)$/.exec(s);
+  return m ? { label: m[1] + " —", rest: m[2], heading: false } : null;
+}
+
+// "(1) wrap …; (2) picks …" is a list written out as one sentence.
+function enumItems(s) {
+  const i = s.search(/(?:^|\s)\(1\)\s/);
+  if (i < 0 || !/\s\(2\)\s/.test(s.slice(i))) return null;
+  const items = s.slice(i).trim().split(/[;,]?\s+(?=\(\d+\)\s)/).map(x => x.trim()).filter(Boolean);
+  return items.length >= 2 ? { lead: s.slice(0, i).trim(), items } : null;
+}
