# Credentials & secrets
*.key
*.json
*-key.json
.env
.env.local
.env.*.local
credentials/

# BigQuery service account
gcloud-key.json
service-account-key.json

# Skill sources under .claude/skills/ carry version-controlled config and
# reference JSON (config.json, tokens.json, bq_schema.json). The blanket
# *.json rule above must not silently swallow them...
!.claude/skills/**/*.json
# ...but credential-shaped names stay ignored everywhere, no exceptions.
sa.json
**/sa.json
*-key.json
*-credentials.json
**/*-key.json
**/*-credentials.json

# Local Claude Code state — never committed (machine-specific, may hold tokens)
.claude/settings.local.json
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/session-env/
.claude/backups/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Invoice data (keep samples, exclude actual invoice PDFs and data)
*.pdf
!samples/*.pdf
!samples/*.xlsx

# BigQuery temp files
*.tmp
*.temp

# Test outputs
test_output/
.pytest_cache/
htmlcov/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
