{
  "$schema": "https://design-tokens.dev/schema",
  "name": "Americanflat Design System",
  "version": "1.0.0",
  "source": "Americanflat Brand Guidelines v5 (Feb 2025)",
  "color": {
    "primary": {
      "black":  { "value": "#0F0F0F", "note": "AF Black, not true black" },
      "white":  { "value": "#FFFFFF" }
    },
    "grey": {
      "4": { "value": "#1A1A1A" },
      "3": { "value": "#666666" },
      "2": { "value": "#B3B3B3" },
      "1": { "value": "#E6E6E6" }
    },
    "accent": {
      "red":  { "value": "#CE0E2D", "use": "Amazon contexts, alerts only" },
      "blue": { "value": "#003595", "use": "Amazon contexts, formal doc links" }
    },
    "balance": {
      "white_pct": 70,
      "black_pct": 20,
      "accent_pct": 5,
      "secondary_pct": 5
    }
  },
  "font": {
    "family": {
      "primary":  "Glacial Indifference",
      "japanese": "Hiragino Kaku Gothic Pron",
      "fallback": "DM Sans, Inter, system-ui, sans-serif"
    },
    "weight": {
      "regular": 400,
      "bold": 700
    },
    "scale_pt": {
      "h1": 48,
      "h2": 30,
      "subhead": 24,
      "descriptor": 24,
      "body": 21,
      "footer": 12
    }
  },
  "spacing_px": {
    "1": 4, "2": 8, "3": 16, "4": 24,
    "5": 32, "6": 48, "7": 64, "8": 96
  },
  "radius_px": {
    "sm": 4, "md": 8, "lg": 16, "pill": 9999
  },
  "logo": {
    "primary":      "assets/logo-wordmark.svg",
    "icon":         "assets/logo-icon.svg",
    "min_size_pt":  30,
    "placement":    "top-center (single page) or top-left (multi page)",
    "clear_space":  "Equal to the height of one logo character on all sides"
  },
  "voice": {
    "summary": "Everlane of home décor",
    "rules": [
      "Casual but not child-like",
      "Clean but not cold",
      "Simple but not dumbed-down",
      "Optimistic but still practical",
      "Welcoming but not overly familiar"
    ]
  }
}
